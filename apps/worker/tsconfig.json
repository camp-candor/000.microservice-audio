{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["@cloudflare/workers-types"],
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*", "test/**/*"]
}
