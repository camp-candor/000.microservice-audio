{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        // STRICTNESS LEVEL 100
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@camp_candor/700.microserviceaudio": [
                "./packages/700.microserviceaudio/BEE.ts"
            ]
        }
    },
    "files": [],
    "exclude": ["node_modules", "dist"],
    "references": [
        { "path": "./packages/700.microserviceaudio" },
        { "path": "./apps/worker" }
    ]
}
